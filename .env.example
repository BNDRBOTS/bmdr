# Generate a random secret of at least 32 characters and store it only in Netlify.
BMDR_SESSION_SECRET=replace-with-a-long-random-secret

# Gumroad product permalink/slug used by the license verification API.
GUMROAD_PRODUCT_PERMALINK=bemdr

# Public checkout URL displayed by the access gate.
GUMROAD_PRODUCT_URL=https://bndrllc.gumroad.com/l/bemdr

# Optional. Defaults to 168 hours (7 days); maximum is 720 hours (30 days).
BMDR_SESSION_TTL_HOURS=168
